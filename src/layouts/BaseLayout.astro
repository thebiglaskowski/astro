---
import BaseHead from '../components/BaseHead.astro';
import { getImage } from 'astro:assets';
import defaultOgImage from '../assets/images/joe_laskowski.webp';

interface Props {
	title: string;
	description?: string;
	image?: string;
	preloadImage?: string;
}

const { title, description = '', image, preloadImage } = Astro.props;
const defaultOg = await getImage({ src: defaultOgImage, format: 'webp', width: 1200, height: 1200 });
const ogImage = image ?? defaultOg.src;

const SITE = {
	handle:      'thebiglaskowski',
	bio:         'neural network navigator · crypto enthusiast · command-line cowboy',
	eyebrow:     '— A literary journal of machines, shells & sats —',
	title:       'The Big Laskowski',
	established: 'Established Anno Domini Two Thousand & Twenty-One',
	issue:       'Vol. I · MMXXVI',
	motto:       'Printed & transmitted from the command line',
	socials: [
		{ label: 'GH', href: 'https://github.com/thebiglaskowski' },
		{ label: 'X',  href: 'https://x.com/thebiglaskowski' },
		{ label: 'IN', href: 'https://www.linkedin.com/in/thebiglaskowski' },
		{ label: 'YT', href: 'https://www.youtube.com/@JoeLaskowski' },
	],
	nav: [
		{ label: 'Blog',    href: '/' },
		{ label: 'About',   href: '/about/' },
		{ label: 'Contact', href: '/contact/' },
		{ label: 'Tags',    href: '/tags/' },
		{ label: 'RSS',     href: '/rss.xml' },
	],
};

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
	href === '/'
		? pathname === '/' || pathname.startsWith('/blog/')
		: pathname.startsWith(href);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={ogImage} preloadImage={preloadImage} />
	</head>
	<body>
		<a href="#main-content" class="skip-link">Skip to content</a>
		<div class="pagewrap">
			<div class="running">
				<span>{SITE.issue}</span>
				<span class="star">✦</span>
				<span style="text-align:right">{SITE.motto}</span>
			</div>

			<header class="masthead">
				<div class="mast-eyebrow">{SITE.eyebrow}</div>
				{(pathname === '/' || /^\/\d+\/$/.test(pathname))
					? <h1 class="mast-title"><a href="/">{SITE.title}</a></h1>
					: <p class="mast-title"><a href="/">{SITE.title}</a></p>
				}
				<div class="mast-sub">{SITE.established}</div>
			</header>

			<div class="fleur-rule">
				<span class="line"></span>
				<span class="fleur">❦ ❧ ❦</span>
				<span class="line"></span>
			</div>

			<nav class="navrow">
				<div class="links">
					{SITE.nav.map(item => (
						<a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
							{item.label}
						</a>
					))}
				</div>
				<div class="links">
					{SITE.socials.map(s => (
						<a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a>
					))}
					<button type="button" class="search-toggle" aria-label="Search" aria-expanded="false" aria-controls="search-panel">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<circle cx="11" cy="11" r="8"></circle>
							<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
						</svg>
					</button>
				</div>
			</nav>

			<div id="search-panel" class="search-panel" hidden>
				<div id="search"></div>
			</div>

			<main id="main-content">
				<slot />
			</main>

			<footer class="site-footer">
				<span>{SITE.bio}</span>
				<span class="ornament">⁂</span>
				<span style="text-align:right">© {new Date().getFullYear()} {SITE.handle}</span>
			</footer>
		</div>
	</body>
</html>

<style>
	.skip-link {
		position: absolute;
		left: -9999px;
		top: 0;
		z-index: 100;
		background: var(--oxblood);
		color: var(--paper-bright);
		padding: 0.5rem 1rem;
		font-family: var(--font-sans);
		font-size: 0.85rem;
		text-decoration: none;
		border-radius: 0 0 4px 4px;
	}

	.skip-link:focus {
		left: 50%;
		transform: translateX(-50%);
	}

	.search-toggle {
		background: transparent;
		border: none;
		padding: 0;
		color: var(--mute);
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		font-size: 11.5px;
		letter-spacing: .22em;
		text-transform: uppercase;
		transition: color 0.15s;
		line-height: 1;
	}

	.search-toggle:hover {
		color: var(--steel);
	}

	.search-panel {
		padding: 20px var(--gutter);
		border-bottom: 1px solid var(--rule);
		background: #0d0c0e;
	}

	.search-panel[hidden] {
		display: none;
	}

	:global(#search) {
		--pagefind-ui-primary: var(--oxblood);
		--pagefind-ui-text: var(--paper);
		--pagefind-ui-background: var(--ink);
		--pagefind-ui-border: var(--rule);
		--pagefind-ui-tag: var(--rule-dim);
		--pagefind-ui-border-width: 1px;
		--pagefind-ui-border-radius: 2px;
		--pagefind-ui-font: var(--font-sans);
		max-width: var(--content-max);
	}

	:global(#search .pagefind-ui__search-input) {
		background: var(--ink);
		color: var(--paper);
	}

	:global(#search .pagefind-ui__result-title a) {
		color: var(--oxblood);
	}
</style>

<script>
	type SearchUIOptions = Record<string, unknown>;
	interface PagefindUIWindow extends Window {
		PagefindUI?: new (options: SearchUIOptions) => unknown;
	}
	const w = window as PagefindUIWindow;

	let pagefindLoaded = false;

	function loadPagefind(): Promise<void> {
		if (pagefindLoaded) return Promise.resolve();
		pagefindLoaded = true;
		return new Promise((resolve, reject) => {
			const css = document.createElement('link');
			css.rel = 'stylesheet';
			css.href = '/pagefind/pagefind-ui.css';
			document.head.appendChild(css);

			const js = document.createElement('script');
			js.src = '/pagefind/pagefind-ui.js';
			js.onload = () => {
				if (!w.PagefindUI) { reject(new Error('PagefindUI failed to load')); return; }
				new w.PagefindUI({ element: '#search', showSubResults: true, resetStyles: false });
				resolve();
			};
			js.onerror = () => reject(new Error('PagefindUI script error'));
			document.body.appendChild(js);
		});
	}

	function initSearch() {
		const toggle = document.querySelector<HTMLButtonElement>('.search-toggle');
		const panel = document.querySelector<HTMLElement>('#search-panel');
		if (!toggle || !panel) return;
		if (toggle.dataset.wired === '1') return;
		toggle.dataset.wired = '1';

		toggle.addEventListener('click', async () => {
			const isOpen = !panel.hasAttribute('hidden');
			if (isOpen) {
				panel.setAttribute('hidden', '');
				toggle.setAttribute('aria-expanded', 'false');
			} else {
				panel.removeAttribute('hidden');
				toggle.setAttribute('aria-expanded', 'true');
				try {
					await loadPagefind();
					panel.querySelector<HTMLInputElement>('input')?.focus();
				} catch (err) {
					console.error(err);
				}
			}
		});

		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && !panel.hasAttribute('hidden')) {
				panel.setAttribute('hidden', '');
				toggle.setAttribute('aria-expanded', 'false');
				toggle.focus();
			}
		});

	}

	initSearch();
</script>
