---
import BaseHead from '../components/BaseHead.astro';
import { ClientRouter } from 'astro:transitions';
import { getImage } from 'astro:assets';
import defaultOgImage from '../assets/images/joe_laskowski.webp';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

interface Props {
	title: string;
	description?: string;
	image?: string;
	preloadImage?: string;
	preloadImageSrcset?: string;
	preloadImageSizes?: string;
}

const { title, description = '', image, preloadImage, preloadImageSrcset, preloadImageSizes } = Astro.props;
const defaultOg = await getImage({ src: defaultOgImage, format: 'jpeg', width: 1200, height: 1200 });
const ogImage = image ?? defaultOg.src;

const SOCIALS = [
	{ label: 'GitHub',   href: 'https://github.com/thebiglaskowski' },
	{ label: 'X',        href: 'https://x.com/thebiglaskowski' },
	{ label: 'LinkedIn', href: 'https://www.linkedin.com/in/thebiglaskowski' },
	{ label: 'YouTube',  href: 'https://www.youtube.com/@JoeLaskowski' },
];

const NAV = [
	{ label: 'Journal', href: '/' },
	{ label: 'About',   href: '/about/' },
	{ label: 'Resume',  href: '/resume/' },
	{ label: 'Tags',    href: '/tags/' },
	{ label: 'Contact', href: '/contact/' },
];

const pathname = Astro.url.pathname;
// Archive pages are /2/, /3/, … — numeric like /404/, which must not light up Journal.
const isArchivePage = /^\/\d+\/$/.test(pathname) && pathname !== '/404/';
const isActive = (href: string) =>
	href === '/'
		? pathname === '/' || isArchivePage || pathname.startsWith('/blog/')
		: pathname.startsWith(href);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={ogImage} preloadImage={preloadImage} preloadImageSrcset={preloadImageSrcset} preloadImageSizes={preloadImageSizes} />
		<ClientRouter />
	</head>
	<body>
		<a href="#main-content" class="skip-link">Skip to content</a>

		<header class="site-header">
			<a class="logo" href="/"><span class="it">{SITE_TITLE}</span></a>
			<div class="header-meta">
				<slot name="header-meta" />
			</div>
			<nav class="primary" aria-label="Primary">
				{NAV.map(item => (
					<a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
				))}
			</nav>
			<button type="button" class="search-toggle" aria-label="Search" aria-expanded="false" aria-controls="search-panel">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<circle cx="11" cy="11" r="8"></circle>
					<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
				</svg>
			</button>
			<div class="progress" aria-hidden="true"></div>
			<div id="search-panel" class="search-panel" hidden>
				<div id="search"></div>
			</div>
		</header>

		<main id="main-content">
			<slot />
		</main>

		<footer class="site-footer">
			<span>© {new Date().getFullYear()} Joe Laskowski — {SITE_DESCRIPTION}</span>
			<nav class="footer-links" aria-label="Elsewhere">
				{SOCIALS.map(s => (
					<a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a>
				))}
				<a href="/rss.xml">RSS</a>
			</nav>
		</footer>
	</body>
</html>

<style>
	.skip-link {
		position: absolute;
		left: -9999px;
		top: 0;
		z-index: 100;
		background: var(--accent);
		color: var(--bg);
		padding: 0.6rem 1rem;
		font-size: 0.85rem;
		border-radius: 0 0 4px 4px;
	}
	.skip-link:focus { left: 50%; transform: translateX(-50%); }

	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		height: var(--header-h);
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto auto;
		align-items: center;
		gap: 24px;
		padding: 0 var(--gutter);
		background: rgba(13, 15, 19, .88);
		backdrop-filter: blur(16px) saturate(1.3);
		-webkit-backdrop-filter: blur(16px) saturate(1.3);
		border-bottom: 1px solid var(--rule-faint);
	}
	.logo { font-family: var(--font-display); font-size: 19px; letter-spacing: -0.03em; color: var(--text-bright); white-space: nowrap; }
	.header-meta { min-width: 0; display: flex; align-items: center; justify-content: center; }
	.primary { display: flex; gap: 2px; }
	.primary a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0 12px;
		font-size: 13.5px;
		font-weight: 500;
		color: var(--muted);
		white-space: nowrap;
	}
	.primary a:hover, .primary a[aria-current="page"] { color: var(--text-bright); }
	.primary a[aria-current="page"] { box-shadow: inset 0 -1px 0 var(--accent); }
	.search-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		padding: 0;
		border: 1px solid var(--rule);
		border-radius: 50%;
		background: transparent;
		color: var(--muted);
		cursor: pointer;
		transition: color .2s, border-color .2s;
	}
	.search-toggle:hover, .search-toggle[aria-expanded="true"] { color: var(--accent); border-color: var(--accent); }

	.progress {
		position: absolute;
		left: 0;
		right: 0;
		bottom: -1px;
		height: 2px;
		background: var(--accent);
		transform-origin: 0 50%;
		transform: scaleX(0);
	}
	@supports (animation-timeline: scroll()) {
		.progress { animation-name: progress; animation-timing-function: linear; animation-fill-mode: both; animation-timeline: scroll(root); }
		@keyframes progress { to { transform: scaleX(1); } }
	}

	.search-panel {
		position: absolute;
		top: 100%;
		left: 0;
		right: 0;
		padding: 24px var(--gutter) 32px;
		background: var(--bg);
		border-bottom: 1px solid var(--rule);
		max-height: calc(100vh - var(--header-h));
		overflow-y: auto;
	}
	.search-panel[hidden] { display: none; }

	:global(#search) {
		--pagefind-ui-primary: var(--accent);
		--pagefind-ui-text: var(--text);
		--pagefind-ui-background: var(--surface);
		--pagefind-ui-border: var(--rule);
		--pagefind-ui-tag: var(--surface-2);
		--pagefind-ui-border-width: 1px;
		--pagefind-ui-border-radius: 8px;
		--pagefind-ui-font: var(--font-ui);
		max-width: 900px;
		margin: 0 auto;
	}
	:global(#search .pagefind-ui__search-input) { background: var(--surface); color: var(--text-bright); }
	:global(#search .pagefind-ui__result-title a) { color: var(--accent); }

	.site-footer {
		margin-top: 80px;
		padding: 40px var(--gutter);
		border-top: 1px solid var(--rule-faint);
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 20px;
		font-size: 13px;
		color: var(--muted);
	}
	.footer-links { display: flex; flex-wrap: wrap; gap: 4px 20px; }
	.footer-links a { display: inline-flex; align-items: center; min-height: 44px; }

	@media (max-width: 1180px) {
		.header-meta { visibility: hidden; }
	}
	@media (max-width: 820px) {
		.site-header {
			grid-template-columns: minmax(0, 1fr) auto;
			grid-template-rows: 60px 48px;
			gap: 0 12px;
			align-content: start;
		}
		.header-meta { display: none; }
		.primary {
			grid-column: 1 / -1;
			grid-row: 2;
			margin: 0 calc(-1 * var(--gutter));
			padding: 0 calc(var(--gutter) - 12px);
			overflow-x: auto;
			scrollbar-width: none;
			border-top: 1px solid var(--rule-faint);
		}
		.search-toggle { grid-column: 2; grid-row: 1; }
	}
</style>

<script>
	type SearchUIOptions = Record<string, unknown>;
	interface PagefindUIWindow extends Window {
		PagefindUI?: new (options: SearchUIOptions) => unknown;
	}
	const w = window as PagefindUIWindow;

	let pagefindLoaded = false;

	function loadPagefind(): Promise<void> {
		if (pagefindLoaded) return Promise.resolve();
		pagefindLoaded = true;
		return new Promise((resolve, reject) => {
			const css = document.createElement('link');
			css.rel = 'stylesheet';
			css.href = '/pagefind/pagefind-ui.css';
			document.head.appendChild(css);

			const js = document.createElement('script');
			js.src = '/pagefind/pagefind-ui.js';
			js.onload = () => {
				if (!w.PagefindUI) { reject(new Error('PagefindUI failed to load')); return; }
				new w.PagefindUI({ element: '#search', showSubResults: true, resetStyles: false });
				resolve();
			};
			js.onerror = () => reject(new Error('PagefindUI script error'));
			document.body.appendChild(js);
		});
	}

	function initSearch() {
		const toggle = document.querySelector<HTMLButtonElement>('.search-toggle');
		const panel = document.querySelector<HTMLElement>('#search-panel');
		if (!toggle || !panel) return;
		if (toggle.dataset.wired === '1') return;
		toggle.dataset.wired = '1';

		toggle.addEventListener('click', async () => {
			const isOpen = !panel.hasAttribute('hidden');
			if (isOpen) {
				panel.setAttribute('hidden', '');
				toggle.setAttribute('aria-expanded', 'false');
			} else {
				panel.removeAttribute('hidden');
				toggle.setAttribute('aria-expanded', 'true');
				try {
					await loadPagefind();
					panel.querySelector<HTMLInputElement>('input')?.focus();
				} catch (err) {
					console.error(err);
				}
			}
		});

		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && !panel.hasAttribute('hidden')) {
				panel.setAttribute('hidden', '');
				toggle.setAttribute('aria-expanded', 'false');
				toggle.focus();
			}
		});

		document.addEventListener('astro:before-preparation', () => {
			if (!panel.hasAttribute('hidden')) {
				panel.setAttribute('hidden', '');
				toggle.setAttribute('aria-expanded', 'false');
			}
		});
	}

	initSearch();
	document.addEventListener('astro:page-load', initSearch);
</script>
