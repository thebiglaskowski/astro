---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import { getImage } from 'astro:assets';
import defaultOgImage from '../assets/images/joe_laskowski.webp';

interface Props {
	title: string;
	description: string;
	image?: string;
	preloadImage?: string;
}

const { title, description, image, preloadImage } = Astro.props;
const defaultOg = await getImage({ src: defaultOgImage, format: 'webp', width: 1200, height: 1200 });
const ogImage = image ?? defaultOg.src;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={ogImage} preloadImage={preloadImage} />
		<ClientRouter />
	</head>
	<body>
		<Header />
		<main id="main-content">
			<slot />
		</main>
		<Footer />
	</body>
</html>
