---
import { Image, getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import ShareLinks from '../components/ShareLinks.astro';
import {
	slugifyTag,
	readingTimeMinutes,
	getRelatedPosts,
	getPublishedPosts,
} from '../lib/blog';
import 'glightbox/dist/css/glightbox.min.css';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, tags } = post.data;

const heroFullUrl = heroImage
	? (await getImage({ src: heroImage, format: 'webp' })).src
	: undefined;

// Dedicated social-card image: 1200x630 JPEG (cover-cropped). JPEG + the 1200px
// cap keeps X/Twitter happy — it skips oversized images and renders WebP unreliably.
const ogImage = heroImage
	? (await getImage({ src: heroImage, width: 1200, height: 630, format: 'jpeg' })).src
	: undefined;

// Shared between the rendered hero <Image> and its responsive preload, so the
// browser preloads exactly the variant it will display (no double-fetch, no
// preloading the full-res original).
const heroSizes = '(max-width: 720px) calc(100vw - 44px), (max-width: 980px) calc(100vw - 112px), 980px';
// Params MUST match the hero <Image> exactly (width/height/widths/format) so the
// preloaded variants are the same files the browser will display.
const heroResponsive = heroImage
	? await getImage({ src: heroImage, width: 1020, height: 510, widths: [480, 768, 1020], format: 'webp' })
	: undefined;

const minutes = readingTimeMinutes(post.body);

const allPosts = await getPublishedPosts();
const related = getRelatedPosts(post, allPosts, 3);

const canonicalUrl = new URL(`/blog/${post.id}/`, Astro.site);
const heroAbsoluteUrl = heroFullUrl ? new URL(heroFullUrl, Astro.site).toString() : undefined;

const postJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	datePublished: pubDate.toISOString(),
	...(updatedDate && { dateModified: updatedDate.toISOString() }),
	...(heroAbsoluteUrl && { image: heroAbsoluteUrl }),
	...(tags && tags.length > 0 && { keywords: tags.join(', ') }),
	author: {
		'@type': 'Person',
		name: 'Joe Laskowski',
		url: new URL('/about/', Astro.site).toString(),
	},
	publisher: {
		'@type': 'Person',
		name: 'Joe Laskowski',
	},
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': canonicalUrl.toString(),
	},
};

const breadcrumbJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: 'Blog',
			item: new URL('/', Astro.site).toString(),
		},
		{
			'@type': 'ListItem',
			position: 2,
			name: title,
			item: canonicalUrl.toString(),
		},
	],
};
---

<BaseLayout title={title} description={description} image={ogImage} preloadImageSrcset={heroResponsive?.srcSet.attribute} preloadImageSizes={heroSizes}>
	<script type="application/ld+json" set:html={JSON.stringify(postJsonLd)} />
	<script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

	<article class="post-page">
		<div class="lead-kicker">
			<span class="manicule">☞</span>
			{tags && tags.length > 0 ? <span>{tags[0]}</span> : <span>Essay</span>}
			<span class="sep">§</span>
			<span class="italic"><FormattedDate date={pubDate} /></span>
			<span class="sep">§</span>
			<span>{minutes} min read</span>
			{updatedDate && (
				<>
					<span class="sep">§</span>
					<span class="italic">Updated <FormattedDate date={updatedDate} /></span>
				</>
			)}
		</div>

		<h1 class="lead-title">{title}</h1>

		{tags && tags.length > 0 && (
			<ul class="post-tags" role="list">
				{tags.map((tag) => (
					<li>
						<a href={`/tags/${slugifyTag(tag)}/`} class="tag-pill">{tag}</a>
					</li>
				))}
			</ul>
		)}

		{heroImage && (
			<>
				<figure class="plate">
					<a href={heroFullUrl} class="glightbox" data-type="image" data-title={title}>
						<Image src={heroImage} alt={title || ''} width={1020} height={510} widths={[480, 768, 1020]} sizes={heroSizes} loading="eager" fetchpriority="high" />
					</a>
					<span class="corner-bl"></span>
					<span class="corner-br"></span>
				</figure>
				<div class="plate-cap">
					<span>{title}</span>
					<span>Fig. I</span>
				</div>
			</>
		)}

		<div class="prose">
			<slot />
		</div>

		<ShareLinks url={Astro.url.href} title={title} />

		<template id="copy-icon-tpl">
			<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
				<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
			</svg>
		</template>
		<template id="check-icon-tpl">
			<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<polyline points="20 6 9 17 4 12"></polyline>
			</svg>
		</template>

		{related.length > 0 && (
			<aside class="related" aria-labelledby="related-heading">
				<h2 id="related-heading" class="rail-head"><span class="fleur">❦</span> Further Reading</h2>
				<div class="rail-sub">{related.length} related dispatch{related.length !== 1 ? 'es' : ''}</div>
				{related.map((p) => (
					<a href={`/blog/${p.id}/`} class="toc-row">
						<div class="toc-num">❧</div>
						<div>
							<h4 class="toc-title">{p.data.title}</h4>
							{p.data.description && (
								<div class="toc-meta">{p.data.description}</div>
							)}
						</div>
						<div class="toc-page"><FormattedDate date={p.data.pubDate} /></div>
					</a>
				))}
			</aside>
		)}

		<section class="comments" aria-labelledby="comments-heading">
			<h2 id="comments-heading" class="rail-head"><span class="fleur">❦</span> Marginalia</h2>
			<div class="rail-sub">Sign in with GitHub to leave a note</div>
			<div id="giscus-container"></div>
		</section>

		<div class="byline">
			<a href="/">← Back to the issue</a>
			<span>Set in Newsreader &amp; IBM Plex Sans</span>
		</div>
	</article>

	<script>
		let glightboxLoaded = false;

		function wrapProseImages() {
			const prose = document.querySelector('.prose');
			if (!prose) return;
			prose.querySelectorAll('img').forEach((img) => {
				if (!(img instanceof HTMLImageElement)) return;
				if (img.closest('a') || img.closest('.gallery')) return;

				const wrapper = document.createElement('a');
				wrapper.href = img.src;
				wrapper.classList.add('glightbox');
				wrapper.setAttribute('data-gallery', 'post-images');
				wrapper.setAttribute('data-type', 'image');
				const caption = img.title || img.alt;
				if (caption) wrapper.setAttribute('data-title', caption);

				img.parentNode?.insertBefore(wrapper, img);
				wrapper.appendChild(img);
			});
		}

		async function loadAndInitGlightbox(clickedEl?: HTMLElement) {
			if (glightboxLoaded) return;
			glightboxLoaded = true;

			const { default: GLightbox } = await import('glightbox');

			const galleryIds = new Set<string>();
			document.querySelectorAll<HTMLElement>('.glightbox[data-gallery]').forEach(el => {
				const id = el.dataset.gallery;
				if (id) galleryIds.add(id);
			});

			galleryIds.forEach(id => {
				GLightbox({
					selector: `.glightbox[data-gallery="${id}"]`,
					touchNavigation: true,
					loop: true,
					closeOnOutsideClick: true,
					openEffect: 'fade',
					closeEffect: 'fade',
				});
			});

			const standalone = document.querySelectorAll('.glightbox:not([data-gallery])');
			if (standalone.length > 0) {
				GLightbox({
					selector: '.glightbox:not([data-gallery])',
					touchNavigation: true,
					closeOnOutsideClick: true,
					openEffect: 'fade',
					closeEffect: 'fade',
				});
			}

			if (clickedEl) {
				requestAnimationFrame(() => clickedEl.click());
			}
		}

		function cloneIcon(id: string): Node | null {
			const tpl = document.getElementById(id);
			if (!(tpl instanceof HTMLTemplateElement)) return null;
			return tpl.content.cloneNode(true);
		}

		function setIcon(btn: HTMLElement, id: string) {
			while (btn.firstChild) btn.removeChild(btn.firstChild);
			const icon = cloneIcon(id);
			if (icon) btn.appendChild(icon);
		}

		function addCodeCopyButtons() {
			const prose = document.querySelector('.prose');
			if (!prose) return;
			prose.querySelectorAll<HTMLPreElement>('pre').forEach((pre) => {
				if (pre.querySelector('.copy-btn')) return;
				const code = pre.querySelector('code');
				if (!code) return;

				const btn = document.createElement('button');
				btn.type = 'button';
				btn.className = 'copy-btn';
				btn.setAttribute('aria-label', 'Copy code');
				btn.setAttribute('aria-live', 'polite');
				setIcon(btn, 'copy-icon-tpl');

				btn.addEventListener('click', async () => {
					const text = code.textContent ?? '';
					try {
						await navigator.clipboard.writeText(text);
						setIcon(btn, 'check-icon-tpl');
						btn.setAttribute('aria-label', 'Copied');
						btn.classList.add('copied');
					} catch {
						btn.setAttribute('aria-label', 'Copy failed');
					}
					setTimeout(() => {
						setIcon(btn, 'copy-icon-tpl');
						btn.setAttribute('aria-label', 'Copy code');
						btn.classList.remove('copied');
					}, 1500);
				});

				pre.appendChild(btn);
			});
		}

		let giscusObserver: IntersectionObserver | null = null;

		function mountGiscus(container: HTMLElement) {
			container.replaceChildren();
			const script = document.createElement('script');
			script.src = 'https://giscus.app/client.js';
			script.setAttribute('data-repo', 'thebiglaskowski/astro');
			script.setAttribute('data-repo-id', 'R_kgDOOs-KOg');
			script.setAttribute('data-category', 'Announcements');
			script.setAttribute('data-category-id', 'DIC_kwDOOs-KOs4C-wBr');
			script.setAttribute('data-mapping', 'pathname');
			script.setAttribute('data-strict', '0');
			script.setAttribute('data-reactions-enabled', '1');
			script.setAttribute('data-emit-metadata', '0');
			script.setAttribute('data-input-position', 'bottom');
			script.setAttribute('data-theme', 'https://thebiglaskowski.com/giscus/noir.css');
			script.setAttribute('data-lang', 'en');
			script.setAttribute('data-loading', 'lazy');
			script.crossOrigin = 'anonymous';
			script.async = true;
			container.appendChild(script);
		}

		function initGiscus() {
			// ClientRouter swaps the whole <article>, so this is a fresh node each navigation.
			const container = document.getElementById('giscus-container');
			giscusObserver?.disconnect();
			if (!container || container.dataset.mounted === 'true') return;

			giscusObserver = new IntersectionObserver((entries, obs) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					container.dataset.mounted = 'true';
					mountGiscus(container);
					obs.disconnect();
				}
			}, { rootMargin: '200px' });

			giscusObserver.observe(container);
		}

		let clickDelegated = false;

		function init() {
			wrapProseImages();
			addCodeCopyButtons();
			initGiscus();

			if (clickDelegated) return;
			clickDelegated = true;
			document.addEventListener('click', (e) => {
				const trigger = (e.target as HTMLElement).closest('.glightbox');
				if (!trigger) return;
				if (!glightboxLoaded) {
					e.preventDefault();
					e.stopPropagation();
					loadAndInitGlightbox(trigger as HTMLElement);
				}
			}, { capture: true });
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', init);
		} else {
			init();
		}
		document.addEventListener('astro:page-load', init);
	</script>

	<style>
		.post-tags {
			display: flex;
			flex-wrap: wrap;
			gap: 0.5rem;
			padding: 0;
			margin: 0 0 1.5rem 0;
			list-style: none;
		}

		/* Position copy button relative to pre */
		.prose :global(pre) {
			position: relative;
		}

		.prose :global(.copy-btn) {
			position: absolute;
			top: 0.5rem;
			right: 0.5rem;
			width: 30px;
			height: 30px;
			background: rgba(7,7,10,0.85);
			color: var(--mute);
			border: 1px solid var(--rule);
			border-radius: 2px;
			padding: 0;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			cursor: pointer;
			opacity: 0;
			transition: opacity .15s, color .15s, border-color .15s;
		}

		.prose :global(.copy-btn svg) {
			display: block;
		}

		.prose :global(pre:hover .copy-btn),
		.prose :global(.copy-btn:focus-visible) {
			opacity: 1;
		}

		.prose :global(.copy-btn:hover) {
			color: var(--steel);
			border-color: var(--steel);
		}

		.prose :global(.copy-btn.copied) {
			color: var(--paper-bright);
			border-color: var(--paper-dim);
		}

		/* Images inside prose */
		.prose :global(img) {
			max-width: 100%;
			height: auto;
			margin: 1.5rem auto;
			display: block;
			box-shadow: 0 4px 20px rgba(0,0,0,0.5);
		}

		.prose :global(p:has(> img:only-child)),
		.prose :global(p:has(> a.glightbox:only-child)) {
			text-align: center;
		}

		.prose :global(video) {
			max-width: 100%;
			height: auto;
			margin: 1.5rem auto;
			display: block;
		}

		.prose :global(.video-link) {
			display: inline-block;
		}

		/* Lightbox trigger styles */
		.prose :global(a.glightbox) {
			display: inline-block;
			text-decoration: none;
			cursor: pointer;
			border-bottom: none;
		}

		.prose :global(a.glightbox:hover img) {
			filter: brightness(1.08);
			transition: filter .15s;
		}

		/* Related posts section */
		.related {
			margin: 3rem 0 2rem;
			padding-top: 2rem;
		}

		/* Comments (giscus) section */
		.comments {
			margin: 3rem 0 2rem;
			padding-top: 2rem;
		}

		.comments .rail-sub {
			margin-bottom: 1.5rem;
		}

		#giscus-container {
			min-height: 150px;
		}

		/* GLightbox noir overrides */
		:global(.glightbox-clean .gslide-description) {
			background: var(--ink);
			color: var(--paper);
		}

		:global(.glightbox-clean .gclose),
		:global(.glightbox-clean .gnext),
		:global(.glightbox-clean .gprev) {
			color: var(--paper-bright);
		}

		:global(.goverlay) {
			background: rgba(7,7,10,0.96) !important;
		}
	</style>
</BaseLayout>
