---
import { Image, getImage } from 'astro:assets';
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import ShareLinks from '../components/ShareLinks.astro';
import { slugifyTag, readingTimeMinutes, getPublishedPosts } from '../lib/blog';
import { CAREER_START_YEAR } from '../consts';
import authorImage from '../assets/images/joe_laskowski.webp';
import 'glightbox/dist/css/glightbox.min.css';

interface Props {
	post: CollectionEntry<'blog'>;
	headings: MarkdownHeading[];
}

const { post, headings } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, tags } = post.data;

const heroFullUrl = heroImage
	? (await getImage({ src: heroImage, format: 'webp' })).src
	: undefined;

// Dedicated social-card image: 1200x630 JPEG (cover-cropped). JPEG + the 1200px
// cap keeps X/Twitter happy — it skips oversized images and renders WebP unreliably.
const ogImage = heroImage
	? (await getImage({ src: heroImage, width: 1200, height: 630, format: 'jpeg' })).src
	: undefined;

// The hero is a full-bleed backdrop. Widths stop at the source width (no
// upscaled variants), and the same params feed the <Image> and the preload so
// the browser preloads exactly the file it will display.
const heroSizes = '100vw';
const heroWidths = heroImage
	? [768, 1280, 1920].filter((w) => w < heroImage.width).concat(Math.min(heroImage.width, 1920))
	: [];
const heroResponsive = heroImage
	? await getImage({ src: heroImage, widths: heroWidths, format: 'webp' })
	: undefined;

const minutes = readingTimeMinutes(post.body);
const yearsInIT = new Date().getFullYear() - CAREER_START_YEAR;

// Up next is the previous (older) dispatch; the oldest post wraps to the newest.
const allPosts = await getPublishedPosts();
const index = allPosts.findIndex((p) => p.id === post.id);
const upNext = allPosts[index + 1] ?? (allPosts[0]?.id !== post.id ? allPosts[0] : undefined);
const upNextMinutes = upNext ? readingTimeMinutes(upNext.body) : 0;

const sections = headings.filter((h) => h.depth === 2);

const canonicalUrl = new URL(`/blog/${post.id}/`, Astro.site);
const heroAbsoluteUrl = heroFullUrl ? new URL(heroFullUrl, Astro.site).toString() : undefined;

const postJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	datePublished: pubDate.toISOString(),
	...(updatedDate && { dateModified: updatedDate.toISOString() }),
	...(heroAbsoluteUrl && { image: heroAbsoluteUrl }),
	...(tags && tags.length > 0 && { keywords: tags.join(', ') }),
	author: {
		'@type': 'Person',
		name: 'Joe Laskowski',
		url: new URL('/about/', Astro.site).toString(),
	},
	publisher: {
		'@type': 'Person',
		name: 'Joe Laskowski',
	},
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': canonicalUrl.toString(),
	},
};

const breadcrumbJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: 'Blog',
			item: new URL('/', Astro.site).toString(),
		},
		{
			'@type': 'ListItem',
			position: 2,
			name: title,
			item: canonicalUrl.toString(),
		},
	],
};
---

<BaseLayout title={title} description={description} image={ogImage} preloadImageSrcset={heroResponsive?.srcSet.attribute} preloadImageSizes={heroSizes}>
	<div slot="header-meta" class="header-post">
		<span class="header-title">{title}</span>
		<svg class="ring" width="26" height="26" viewBox="0 0 36 36" aria-hidden="true">
			<circle cx="18" cy="18" r="15" fill="none" stroke="rgba(236,231,221,.14)" stroke-width="3"></circle>
			<circle class="ring-fg" cx="18" cy="18" r="15" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" pathLength="100"></circle>
		</svg>
	</div>

	<script is:inline type="application/ld+json" set:html={JSON.stringify(postJsonLd)} />
	<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

	<article class="post">
		<header class={`post-hero${heroImage ? '' : ' no-image'}`}>
			{heroImage && (
				<Image
					class="hero-backdrop"
					src={heroImage}
					alt=""
					widths={heroWidths}
					sizes={heroSizes}
					format="webp"
					loading="eager"
					fetchpriority="high"
				/>
			)}
			<div class="hero-shade"></div>
			<div class="hero-copy">
				{tags && tags.length > 0 && (
					<ul class="post-tags hero-in" role="list" style="animation-delay: .1s">
						{tags.map((tag) => (
							<li><a href={`/tags/${slugifyTag(tag)}/`} class="tag-pill">{tag}</a></li>
						))}
					</ul>
				)}
				<h1 class="post-title hero-in" style="animation-delay: .25s">{title}</h1>
				<p class="post-dek hero-in" style="animation-delay: .4s">{description}</p>
				<div class="byline hero-in" style="animation-delay: .55s">
					<Image src={authorImage} alt="" width={44} height={44} widths={[44, 88]} sizes="44px" class="byline-avatar" />
					<span>
						<a href="/about/" class="byline-name">Joe Laskowski</a>
						· <FormattedDate date={pubDate} /> · {minutes} min read
						{updatedDate && <> · Updated <FormattedDate date={updatedDate} /></>}
					</span>
				</div>
			</div>
		</header>

		<div class="post-grid">
			{sections.length > 0 && (
				<aside class="post-toc">
					<nav aria-label="Contents">
						<div class="toc-label">Contents</div>
						<a class="toc-link" href="#article-body" data-target="article-body"><span class="n">00</span><span>Intro</span></a>
						{sections.map((h, i) => (
							<a class="toc-link" href={`#${h.slug}`} data-target={h.slug}>
								<span class="n">{String(i + 1).padStart(2, '0')}</span><span>{h.text}</span>
							</a>
						))}
					</nav>
				</aside>
			)}

			<div class="post-main">
				{sections.length > 0 && (
					<details class="toc-mobile">
						<summary>Contents</summary>
						{sections.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
					</details>
				)}

				<div class="prose drop-cap" id="article-body">
					<slot />
				</div>

				<footer class="post-end">
					{tags && tags.length > 0 && (
						<ul class="post-tags" role="list">
							{tags.map((tag) => (
								<li><a href={`/tags/${slugifyTag(tag)}/`} class="tag-pill">{tag}</a></li>
							))}
						</ul>
					)}

					<ShareLinks url={canonicalUrl.toString()} title={title} />

					<div class="author rise">
						<Image src={authorImage} alt="Joe Laskowski" width={96} height={96} widths={[96, 192]} sizes="96px" class="author-photo" />
						<div class="author-text">
							<span class="author-name">Joe Laskowski</span>
							<p>{yearsInIT} years in IT, currently AI Quality Analyst at Aunalytics. This is where I write when what I'm building wants to be a sentence instead of a commit message.</p>
							<a href="/about/" class="readlink">More about me →</a>
						</div>
					</div>
				</footer>
			</div>
		</div>

		{upNext && (
			<section class="up-next" aria-labelledby="up-next-heading">
				<div class="up-next-head">
					<span class="eyebrow" id="up-next-heading">Up next — {upNext.data.pubDate < pubDate ? 'the previous dispatch' : 'the latest dispatch'}</span>
					<a href="/" class="up-next-all">All dispatches →</a>
				</div>
				<a class="up-next-card hover-root" href={`/blog/${upNext.id}/`}>
					{upNext.data.heroImage && (
						<span class="frame parallax unveil">
							<Image src={upNext.data.heroImage} alt="" widths={[480, 800, 1200].filter((w) => w < upNext.data.heroImage!.width).concat(Math.min(upNext.data.heroImage.width, 1200))} sizes="(max-width: 900px) calc(100vw - 40px), 55vw" loading="lazy" />
						</span>
					)}
					<span class="up-next-text">
						<span class="up-next-title"><span class="ul">{upNext.data.title}</span></span>
						<span class="up-next-desc">{upNext.data.description}</span>
						<span class="up-next-meta"><FormattedDate date={upNext.data.pubDate} /> · {upNextMinutes} min read</span>
					</span>
				</a>
			</section>
		)}

		<section class="comments" aria-labelledby="comments-heading">
			<div class="comments-head">
				<h2 id="comments-heading">Discussion</h2>
				<span>via GitHub Discussions</span>
			</div>
			<div class="comments-load">
				<button type="button" class="btn giscus-load">Load the conversation</button>
			</div>
			<div class="comments-skeleton" hidden>
				<div class="sk-row"><div class="sk sk-avatar"></div><div class="sk-lines"><div class="sk" style="width: 30%"></div><div class="sk" style="width: 90%"></div><div class="sk" style="width: 70%"></div></div></div>
				<div class="sk-row"><div class="sk sk-avatar"></div><div class="sk-lines"><div class="sk" style="width: 24%"></div><div class="sk" style="width: 80%"></div></div></div>
			</div>
			<div id="giscus-container"></div>
		</section>

		<template id="copy-icon-tpl">
			<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
				<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
			</svg>
		</template>
		<template id="check-icon-tpl">
			<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<polyline points="20 6 9 17 4 12"></polyline>
			</svg>
		</template>
	</article>

	<script>
		let glightboxLoaded = false;

		function wrapProseImages() {
			const prose = document.querySelector('.prose');
			if (!prose) return;
			prose.querySelectorAll('img').forEach((img) => {
				if (!(img instanceof HTMLImageElement)) return;
				if (img.closest('a') || img.closest('.gallery')) return;

				const wrapper = document.createElement('a');
				wrapper.href = img.src;
				wrapper.classList.add('glightbox');
				wrapper.setAttribute('data-gallery', 'post-images');
				wrapper.setAttribute('data-type', 'image');
				const caption = img.title || img.alt;
				if (caption) wrapper.setAttribute('data-title', caption);

				img.parentNode?.insertBefore(wrapper, img);
				wrapper.appendChild(img);
			});
		}

		async function loadAndInitGlightbox(clickedEl?: HTMLElement) {
			if (glightboxLoaded) return;
			glightboxLoaded = true;

			const { default: GLightbox } = await import('glightbox');

			const galleryIds = new Set<string>();
			document.querySelectorAll<HTMLElement>('.glightbox[data-gallery]').forEach(el => {
				const id = el.dataset.gallery;
				if (id) galleryIds.add(id);
			});

			galleryIds.forEach(id => {
				GLightbox({
					selector: `.glightbox[data-gallery="${id}"]`,
					touchNavigation: true,
					loop: true,
					closeOnOutsideClick: true,
					openEffect: 'fade',
					closeEffect: 'fade',
				});
			});

			const standalone = document.querySelectorAll('.glightbox:not([data-gallery])');
			if (standalone.length > 0) {
				GLightbox({
					selector: '.glightbox:not([data-gallery])',
					touchNavigation: true,
					closeOnOutsideClick: true,
					openEffect: 'fade',
					closeEffect: 'fade',
				});
			}

			if (clickedEl) {
				requestAnimationFrame(() => clickedEl.click());
			}
		}

		function cloneIcon(id: string): Node | null {
			const tpl = document.getElementById(id);
			if (!(tpl instanceof HTMLTemplateElement)) return null;
			return tpl.content.cloneNode(true);
		}

		function setIcon(btn: HTMLElement, id: string) {
			while (btn.firstChild) btn.removeChild(btn.firstChild);
			const icon = cloneIcon(id);
			if (icon) btn.appendChild(icon);
		}

		function addCodeCopyButtons() {
			const prose = document.querySelector('.prose');
			if (!prose) return;
			prose.querySelectorAll<HTMLPreElement>('pre').forEach((pre) => {
				if (pre.querySelector('.copy-btn')) return;
				const code = pre.querySelector('code');
				if (!code) return;

				const btn = document.createElement('button');
				btn.type = 'button';
				btn.className = 'copy-btn';
				btn.setAttribute('aria-label', 'Copy code');
				btn.setAttribute('aria-live', 'polite');
				setIcon(btn, 'copy-icon-tpl');

				btn.addEventListener('click', async () => {
					const text = code.textContent ?? '';
					try {
						await navigator.clipboard.writeText(text);
						setIcon(btn, 'check-icon-tpl');
						btn.setAttribute('aria-label', 'Copied');
						btn.classList.add('copied');
					} catch {
						btn.setAttribute('aria-label', 'Copy failed');
					}
					setTimeout(() => {
						setIcon(btn, 'copy-icon-tpl');
						btn.setAttribute('aria-label', 'Copy code');
						btn.classList.remove('copied');
					}, 1500);
				});

				pre.appendChild(btn);
			});
		}

		// The custom theme has to be reachable from giscus.app's iframe over
		// public HTTPS, so it only applies on the deployed site.
		const GISCUS_THEME = location.hostname === 'thebiglaskowski.com'
			? 'https://thebiglaskowski.com/giscus/longform.css'
			: 'transparent_dark';

		function mountGiscus(container: HTMLElement) {
			container.replaceChildren();
			const script = document.createElement('script');
			script.src = 'https://giscus.app/client.js';
			script.setAttribute('data-repo', 'thebiglaskowski/astro');
			script.setAttribute('data-repo-id', 'R_kgDOOs-KOg');
			script.setAttribute('data-category', 'Announcements');
			script.setAttribute('data-category-id', 'DIC_kwDOOs-KOs4C-wBr');
			script.setAttribute('data-mapping', 'pathname');
			script.setAttribute('data-strict', '0');
			script.setAttribute('data-reactions-enabled', '1');
			script.setAttribute('data-emit-metadata', '0');
			script.setAttribute('data-input-position', 'bottom');
			script.setAttribute('data-theme', GISCUS_THEME);
			script.setAttribute('data-lang', 'en');
			script.crossOrigin = 'anonymous';
			script.async = true;
			container.appendChild(script);
		}

		// Comments load on request: the reader asks for the thread, a skeleton
		// holds the space, and the skeleton leaves once giscus's iframe arrives.
		function loadComments() {
			const container = document.getElementById('giscus-container');
			const skeleton = document.querySelector<HTMLElement>('.comments-skeleton');
			const prompt = document.querySelector<HTMLElement>('.comments-load');
			if (!container || container.dataset.mounted === 'true') return;
			container.dataset.mounted = 'true';
			prompt?.setAttribute('hidden', '');
			skeleton?.removeAttribute('hidden');

			const done = new MutationObserver(() => {
				const frame = container.querySelector('iframe');
				if (!frame) return;
				frame.addEventListener('load', () => skeleton?.setAttribute('hidden', ''), { once: true });
				done.disconnect();
			});
			done.observe(container, { childList: true, subtree: true });
			mountGiscus(container);
		}

		let tocObserver: IntersectionObserver | null = null;

		// Highlights the contents entry for the section being read: the last
		// heading that has scrolled above the upper third of the viewport.
		function initToc() {
			tocObserver?.disconnect();
			const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc-link'));
			if (links.length === 0) return;
			const targets = links
				.map((a) => document.getElementById(a.dataset.target ?? ''))
				.filter((el): el is HTMLElement => el !== null);

			const update = () => {
				let active = 0;
				targets.forEach((el, i) => {
					if (el.getBoundingClientRect().top < window.innerHeight * 0.35) active = i;
				});
				links.forEach((a, i) => a.classList.toggle('on', i === active));
			};

			// Any heading crossing the 40% line changes the answer; re-measure then.
			tocObserver = new IntersectionObserver(update, { rootMargin: '0px 0px -60% 0px' });
			targets.forEach((el) => tocObserver?.observe(el));
			update();
		}

		let clickDelegated = false;

		function init() {
			wrapProseImages();
			addCodeCopyButtons();
			initToc();

			if (clickDelegated) return;
			clickDelegated = true;
			document.addEventListener('click', (e) => {
				const target = e.target as HTMLElement;
				if (target.closest('.giscus-load')) {
					loadComments();
					return;
				}
				const trigger = target.closest('.glightbox');
				if (!trigger) return;
				if (!glightboxLoaded) {
					e.preventDefault();
					e.stopPropagation();
					loadAndInitGlightbox(trigger as HTMLElement);
				}
			}, { capture: true });
		}

		document.addEventListener('astro:page-load', init);
	</script>

	<style>
		/* ---- Header meta (title + reading ring, shown once past the hero) ---- */
		.header-post { display: flex; align-items: center; gap: 14px; min-width: 0; color: var(--accent); opacity: 0; }
		.header-title {
			min-width: 0;
			overflow: hidden;
			white-space: nowrap;
			text-overflow: ellipsis;
			font-size: 13.5px;
			color: var(--text-dim);
		}
		.ring { flex-shrink: 0; transform: rotate(-90deg); }
		.ring-fg { stroke-dasharray: 100; stroke-dashoffset: 100; }

		/* ---- Hero ---- */
		.post-hero {
			position: relative;
			height: calc(100svh - var(--header-h));
			min-height: 560px;
			margin-top: calc(-1 * var(--header-h));
			padding-top: var(--header-h);
			box-sizing: content-box;
			overflow: hidden;
			display: flex;
			align-items: flex-end;
		}
		.post-hero.no-image { height: auto; min-height: 0; padding-top: calc(var(--header-h) + 120px); }
		.post-hero :global(.hero-backdrop) {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			object-fit: cover;
			opacity: .6;
		}
		.hero-shade {
			position: absolute;
			inset: 0;
			background:
				linear-gradient(to right, rgba(13, 15, 19, .75), transparent 65%),
				linear-gradient(to top, var(--bg) 10%, rgba(13, 15, 19, .6) 55%, rgba(13, 15, 19, .25));
		}
		.hero-copy {
			position: relative;
			width: 100%;
			padding: 0 96px 88px;
			display: flex;
			flex-direction: column;
			gap: 26px;
		}
		.post-tags { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; list-style: none; }
		.post-title { max-width: 18ch; font-size: clamp(36px, 5.6vw, 80px); line-height: 1; letter-spacing: -0.05em; }
		.post-dek { margin: 0; max-width: 46ch; font-family: var(--font-text); font-size: 23px; line-height: 1.5; color: var(--text-dim); }
		.byline { display: flex; align-items: center; gap: 14px; font-size: 13.5px; color: var(--muted); }
		.byline :global(.byline-avatar) { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
		.byline-name { color: var(--text-bright); font-weight: 600; }

		/* ---- Body grid: contents | prose | margin ---- */
		.post-grid {
			display: grid;
			grid-template-columns: 220px minmax(0, 700px) 220px;
			justify-content: center;
			gap: 64px;
			padding: 96px var(--gutter) 0;
		}
		.post-main { grid-column: 2; min-width: 0; }
		.post-toc { grid-column: 1; }
		.post-toc nav { position: sticky; top: calc(var(--header-h) + 48px); display: flex; flex-direction: column; }
		.toc-label { margin-bottom: 14px; font-size: 11px; font-weight: 600; letter-spacing: .22em; text-transform: uppercase; color: var(--faint); }
		.toc-link {
			display: grid;
			grid-template-columns: 26px 1fr;
			gap: 8px;
			align-items: baseline;
			min-height: 44px;
			padding: 10px 0 10px 14px;
			border-left: 1px solid var(--rule);
			font-size: 13px;
			line-height: 1.45;
			color: var(--faint);
			transition: color .25s, border-color .25s;
		}
		.toc-link:hover { color: var(--text-bright); }
		.toc-link.on { color: var(--text-bright); border-left-color: var(--accent); }
		.toc-link .n { font-size: 11px; color: var(--faint); }
		.toc-link.on .n { color: var(--accent); }

		.toc-mobile { display: none; }

		/* Break body figures out into the right margin on wide screens */
		.prose :global(.body-figure) { margin-right: -284px; }

		/* ---- Code copy button ---- */
		.prose :global(.copy-btn) {
			position: absolute;
			top: 10px;
			right: 10px;
			width: 32px;
			height: 32px;
			padding: 0;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			background: rgba(13, 15, 19, .85);
			color: var(--muted);
			border: 1px solid var(--rule);
			border-radius: 6px;
			cursor: pointer;
			opacity: 0;
			transition: opacity .15s, color .15s, border-color .15s;
		}
		.prose :global(.copy-btn svg) { display: block; }
		.prose :global(pre:hover .copy-btn),
		.prose :global(.copy-btn:focus-visible) { opacity: 1; }
		.prose :global(.copy-btn:hover) { color: var(--accent); border-color: var(--accent); }
		.prose :global(.copy-btn.copied) { color: var(--text-bright); border-color: var(--text-dim); }

		/* ---- Prose media ---- */
		.prose :global(img) { max-width: 100%; height: auto; display: block; border-radius: 4px; }
		.prose :global(p:has(> img:only-child)),
		.prose :global(p:has(> a.glightbox:only-child)) { text-align: center; }
		.prose :global(video) { max-width: 100%; height: auto; display: block; margin: 1.5rem auto; }
		.prose :global(a.glightbox) { display: inline-block; background-image: none; cursor: pointer; }
		.prose :global(a.glightbox:hover) { background-size: 0 0; }
		.prose :global(a.glightbox:hover img) { filter: brightness(1.08); transition: filter .15s; }

		/* ---- End of post ---- */
		.post-end { display: flex; flex-direction: column; gap: 32px; margin-top: 56px; padding-top: 32px; border-top: 1px solid var(--rule); }
		.author {
			display: grid;
			grid-template-columns: 96px 1fr;
			gap: 28px;
			align-items: center;
			padding: 32px;
			border-radius: 8px;
			background: var(--surface);
		}
		.author :global(.author-photo) { width: 96px; height: 96px; border-radius: 50%; object-fit: cover; }
		.author-text { display: flex; flex-direction: column; gap: 8px; }
		.author-name { font-family: var(--font-display); font-size: 22px; color: var(--text-bright); letter-spacing: -0.03em; }
		.author-text p { margin: 0; font-size: 14px; line-height: 1.65; color: var(--muted); }

		/* ---- Up next ---- */
		.up-next { padding: 96px 96px 0; margin-top: 96px; border-top: 1px solid var(--rule-faint); }
		.up-next-head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin-bottom: 40px; }
		.up-next-all { font-size: 13.5px; color: var(--muted); }
		.up-next-card { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 40px; align-items: end; }
		.up-next-card .frame { grid-column: span 7; }
		.up-next-text { grid-column: span 5; display: flex; flex-direction: column; gap: 20px; padding-bottom: 8px; }
		.up-next-title { font-family: var(--font-display); font-size: clamp(28px, 3.4vw, 52px); line-height: 1.02; letter-spacing: -0.05em; color: var(--text-bright); }
		.up-next-desc {
			font-family: var(--font-text);
			font-size: 18px;
			line-height: 1.6;
			color: var(--muted);
			display: -webkit-box;
			-webkit-line-clamp: 3;
			-webkit-box-orient: vertical;
			overflow: hidden;
		}
		.up-next-meta { font-size: 13px; color: var(--faint); }

		/* ---- Comments ---- */
		.comments { max-width: 700px; margin: 0 auto; padding: 96px var(--gutter) 0; box-sizing: content-box; }
		.comments-head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin-bottom: 28px; }
		.comments-head h2 { font-size: 28px; }
		.comments-head span { font-size: 12.5px; color: var(--faint); }
		.comments-load[hidden], .comments-skeleton[hidden] { display: none; }
		.comments-skeleton { display: flex; flex-direction: column; gap: 20px; }
		.sk-row { display: flex; gap: 14px; }
		.sk-avatar { width: 40px; height: 40px; border-radius: 50%; flex-shrink: 0; }
		.sk-lines { flex-grow: 1; display: flex; flex-direction: column; gap: 10px; }
		.sk-lines .sk { height: 14px; }

		/* GLightbox overrides */
		:global(.glightbox-clean .gslide-description) { background: var(--bg); color: var(--text); }
		:global(.glightbox-clean .gclose),
		:global(.glightbox-clean .gnext),
		:global(.glightbox-clean .gprev) { color: var(--text-bright); }
		:global(.goverlay) { background: rgba(13, 15, 19, .96) !important; }

		@supports (animation-timeline: scroll()) {
			@media (prefers-reduced-motion: no-preference) {
				.header-post { animation-name: header-in; animation-timing-function: linear; animation-fill-mode: both; animation-timeline: scroll(root); animation-range: 70vh 90vh; }
				@keyframes header-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
				.ring-fg { animation-name: ring-fill; animation-timing-function: linear; animation-fill-mode: both; animation-timeline: scroll(root); }
				@keyframes ring-fill { to { stroke-dashoffset: 0; } }
			}
		}
		/* Without scroll timelines the header title is simply always visible */
		@supports not (animation-timeline: scroll()) {
			.header-post { opacity: 1; }
			.ring { display: none; }
		}

		@media (max-width: 1240px) {
			.post-grid { grid-template-columns: 200px minmax(0, 700px); gap: 56px; }
			.prose :global(.body-figure) { margin-right: 0; }
		}
		@media (max-width: 1000px) {
			.post-grid { grid-template-columns: minmax(0, 700px); padding-top: 48px; }
			.post-main { grid-column: 1; }
			.post-toc { display: none; }
			.toc-mobile {
				display: block;
				margin-bottom: 40px;
				border: 1px solid var(--rule);
				border-radius: 8px;
				font-size: 14px;
			}
			.toc-mobile summary { min-height: 48px; display: flex; align-items: center; padding: 0 18px; cursor: pointer; color: var(--text-bright); }
			.toc-mobile a { display: flex; align-items: center; min-height: 44px; padding: 0 18px; border-top: 1px solid var(--rule-faint); color: var(--muted); }
			.up-next { padding: 64px var(--gutter) 0; }
			.up-next-card { grid-template-columns: 1fr; gap: 24px; }
			.up-next-card .frame, .up-next-text { grid-column: 1; }
		}
		@media (max-width: 820px) {
			/* Phones: the hero stacks — image at its native 16:9, copy below */
			.post-hero { height: auto; min-height: 0; margin-top: 0; padding-top: 0; display: block; }
			.post-hero :global(.hero-backdrop) { position: static; aspect-ratio: 16 / 9; height: auto; opacity: 1; }
			.hero-shade { display: none; }
			.post-hero.no-image { padding-top: 48px; }
			.hero-copy { padding: 28px var(--gutter) 0; gap: 18px; }
			.post-dek { font-size: 18px; }
			.author { grid-template-columns: 1fr; padding: 24px; }
		}
	</style>
</BaseLayout>
