---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../consts';
import { getAllTags, getPostsByTag } from '../../lib/blog';

export async function getStaticPaths() {
	const tags = await getAllTags();
	return tags.map((tag) => ({
		params: { tag: tag.slug },
		props: { tagName: tag.name, count: tag.count },
	}));
}

type Props = { tagName: string; count: number };

const { tag: tagSlug } = Astro.params;
const { tagName, count } = Astro.props;
const posts = await getPostsByTag(tagSlug!);
---

<BaseLayout
	title={`${tagName} | ${SITE_TITLE}`}
	description={`Posts tagged ${tagName}.`}
>
	<div class="container">
		<nav class="breadcrumb" aria-label="Breadcrumb">
			<a href="/tags/">← All tags</a>
		</nav>

		<section class="tag-header">
			<h1 class="gradient-text">#{tagName}</h1>
			<p>{count} {count === 1 ? 'post' : 'posts'}</p>
		</section>

		<section class="posts-list">
			{posts.map((post) => (
				<article class="post-card card">
					<a href={`/blog/${post.id}/`} class="post-link">
						{post.data.heroImage && (
							<div class="post-image">
								<Image
									src={post.data.heroImage}
									alt={post.data.title}
									width={400}
									height={200}
									loading="lazy"
								/>
							</div>
						)}
						<div class="post-content">
							<time class="post-date">
								<FormattedDate date={post.data.pubDate} />
							</time>
							<h2 class="post-title">{post.data.title}</h2>
							{post.data.description && (
								<p class="post-description">{post.data.description}</p>
							)}
						</div>
					</a>
				</article>
			))}
		</section>
	</div>

	<style>
		.breadcrumb {
			margin: 2rem 0 0 0;
		}

		.breadcrumb a {
			color: var(--text-muted);
			font-size: 0.9rem;
		}

		.breadcrumb a:hover {
			color: var(--accent-blue);
		}

		.tag-header {
			text-align: center;
			margin: 2rem 0 3rem 0;
		}

		.tag-header h1 {
			font-size: 3rem;
			margin-bottom: 0.5rem;
			font-weight: 700;
		}

		.tag-header p {
			color: var(--text-muted);
			font-size: 1rem;
		}

		.posts-list {
			display: grid;
			grid-template-columns: 1fr;
			gap: 1.5rem;
			margin-bottom: 4rem;
		}

		.post-card {
			padding: 0;
			overflow: hidden;
			transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
		}

		.post-card:hover {
			transform: translateY(-2px);
			box-shadow: 0 8px 30px rgba(0, 212, 255, 0.15);
			border-color: var(--border-glow);
		}

		.post-link {
			display: grid;
			grid-template-columns: 200px 1fr;
			text-decoration: none;
			color: inherit;
		}

		.post-image {
			overflow: hidden;
		}

		.post-image img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			border-radius: 0;
		}

		.post-content {
			padding: 1.25rem 1.5rem;
		}

		.post-date {
			color: var(--text-muted);
			font-size: 0.85rem;
			font-weight: 600;
		}

		.post-title {
			font-size: 1.3rem;
			margin: 0.5rem 0;
			color: var(--text-primary);
			transition: color 0.2s ease;
		}

		.post-link:hover .post-title {
			color: var(--accent-blue);
		}

		.post-description {
			color: var(--text-secondary);
			font-size: 0.95rem;
			line-height: 1.5;
			margin: 0.5rem 0 0 0;
			display: -webkit-box;
			-webkit-line-clamp: 2;
			-webkit-box-orient: vertical;
			overflow: hidden;
		}

		@media (max-width: 768px) {
			.tag-header h1 {
				font-size: 2.25rem;
			}

			.post-link {
				grid-template-columns: 1fr;
			}

			.post-image img {
				height: 180px;
			}
		}
	</style>
</BaseLayout>
