---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../consts';
import { getAllTags, getPostsByTag } from '../../lib/blog';

export async function getStaticPaths() {
	const tags = await getAllTags();
	return tags.map((tag) => ({
		params: { tag: tag.slug },
		props: { tagName: tag.name, count: tag.count },
	}));
}

type Props = { tagName: string; count: number };

const { tag: tagSlug } = Astro.params;
const { tagName, count } = Astro.props;
const posts = await getPostsByTag(tagSlug!);
---

<BaseLayout
	title={`${tagName} | ${SITE_TITLE}`}
	description={`Posts tagged ${tagName}.`}
>
	<div class="tag-wrap">
		<nav class="breadcrumb" aria-label="Breadcrumb">
			<a href="/tags/">← All tags</a>
		</nav>

		<section class="tag-header">
			<h1>#{tagName}</h1>
			<p>{count} {count === 1 ? 'post' : 'posts'}</p>
		</section>

		<section class="posts-list">
			{posts.map((post) => (
				<a class="post-card" href={`/blog/${post.id}/`}>
					{post.data.heroImage && (
						<div class="post-image">
							<Image
								src={post.data.heroImage}
								alt={post.data.title}
								width={400}
								height={200}
								loading="lazy"
							/>
						</div>
					)}
					<div class="post-content">
						<span class="post-date">
							<FormattedDate date={post.data.pubDate} />
						</span>
						<h2 class="post-title">{post.data.title}</h2>
						{post.data.description && (
							<p class="post-description">{post.data.description}</p>
						)}
					</div>
				</a>
			))}
		</section>
	</div>

	<style>
		.tag-wrap {
			padding: 28px var(--gutter) 0;
			max-width: 800px;
			margin: 0 auto;
		}

		.breadcrumb {
			margin-bottom: 1.5rem;
		}

		.breadcrumb a {
			font-family: var(--font-sans);
			font-size: 10.5px;
			letter-spacing: .22em;
			text-transform: uppercase;
			color: var(--mute);
			transition: color .15s;
		}

		.breadcrumb a:hover {
			color: var(--paper-bright);
		}

		.tag-header {
			margin-bottom: 2rem;
			padding-bottom: 1.5rem;
			border-bottom: 1px double var(--rule);
		}

		.tag-header h1 {
			font-family: var(--font-serif);
			font-size: clamp(32px, 5vw, 52px);
			font-weight: 500;
			color: var(--paper-bright);
			letter-spacing: -0.02em;
			margin-bottom: 0.25rem;
		}

		.tag-header p {
			font-family: var(--font-sans);
			font-size: 10.5px;
			letter-spacing: .28em;
			text-transform: uppercase;
			color: var(--mute);
		}

		.posts-list {
			display: grid;
			grid-template-columns: 1fr;
			gap: 1px;
			margin-bottom: 4rem;
			border: 1px solid var(--rule);
		}

		.post-card {
			display: grid;
			grid-template-columns: 200px 1fr;
			text-decoration: none;
			color: inherit;
			border-bottom: 1px solid var(--rule-dim);
			transition: background .15s;
		}

		.post-card:last-child {
			border-bottom: none;
		}

		.post-card:hover {
			background: rgba(255,255,255,0.03);
		}

		.post-image {
			overflow: hidden;
			border-right: 1px solid var(--rule-dim);
		}

		.post-image img {
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

		.post-content {
			padding: 1.25rem 1.5rem;
		}

		.post-date {
			font-family: var(--font-sans);
			font-size: 10px;
			letter-spacing: .22em;
			text-transform: uppercase;
			color: var(--mute);
		}

		.post-title {
			font-family: var(--font-serif);
			font-size: 1.2rem;
			font-weight: 500;
			margin: 0.4rem 0 0.5rem;
			color: var(--paper-bright);
			transition: color .15s;
		}

		.post-card:hover .post-title {
			color: var(--steel);
		}

		.post-description {
			font-family: var(--font-serif);
			font-style: italic;
			color: var(--paper-dim);
			font-size: 0.9rem;
			line-height: 1.5;
			margin: 0;
			display: -webkit-box;
			-webkit-line-clamp: 2;
			-webkit-box-orient: vertical;
			overflow: hidden;
		}

		@media (max-width: 768px) {
			.post-card {
				grid-template-columns: 1fr;
			}

			.post-image {
				border-right: none;
				border-bottom: 1px solid var(--rule-dim);
				height: 160px;
			}
		}
	</style>
</BaseLayout>
