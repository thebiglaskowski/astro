---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../consts';
import { getAllTags, getPostsByTag } from '../../lib/blog';

export async function getStaticPaths() {
	const tags = await getAllTags();
	return tags.map((tag) => ({
		params: { tag: tag.slug },
		props: { tagName: tag.name, count: tag.count },
	}));
}

type Props = { tagName: string; count: number };

const { tag: tagSlug } = Astro.params;
const { tagName, count } = Astro.props;
const posts = await getPostsByTag(tagSlug!);
// A tag with one post is a thin page that repeats that post, so it stays out
// of search results (noindex, links still followed) and out of the sitemap.
---

<BaseLayout
	title={`${tagName} | ${SITE_TITLE}`}
	description={`${count} ${count === 1 ? 'dispatch' : 'dispatches'} tagged ${tagName} on ${SITE_TITLE} — notes on AI, the command line, and whatever Joe Laskowski is building next.`}
	noindex={count < 2}
>
	<div class="page-shell tag-wrap">
		<section class="page-head">
			<a class="readlink back" href="/tags/">← All tags</a>
			<h1><span class="hash">#</span>{tagName}</h1>
			<p>{count} {count === 1 ? 'dispatch' : 'dispatches'}</p>
		</section>

		<section class="posts-list">
			{posts.map((post) => (
				<a class="post-row hover-root" href={`/blog/${post.id}/`}>
					{post.data.heroImage && (
						<span class="frame">
							<Image
								src={post.data.heroImage}
								alt=""
								width={480}
								height={270}
								widths={[240, 480]}
								sizes="(max-width: 720px) calc(100vw - 40px), 280px"
								loading="lazy"
							/>
						</span>
					)}
					<span class="post-content">
						<span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
						<span class="post-title"><span class="ul">{post.data.title}</span></span>
						{post.data.description && <span class="post-description">{post.data.description}</span>}
					</span>
				</a>
			))}
		</section>
	</div>

	<style>
		.back { align-self: flex-start; }
		.hash { color: var(--accent); }
		.posts-list { display: flex; flex-direction: column; }
		.post-row {
			display: grid;
			grid-template-columns: 280px minmax(0, 1fr);
			gap: 32px;
			align-items: center;
			padding: 32px 0;
			border-bottom: 1px solid var(--rule-faint);
		}
		.post-row:first-child { padding-top: 0; }
		.post-row:hover { color: inherit; }
		.post-content { display: flex; flex-direction: column; gap: 10px; }
		.post-date { font-size: 13px; color: var(--faint); }
		.post-title { font-family: var(--font-display); font-size: 24px; line-height: 1.15; letter-spacing: -0.04em; color: var(--text-bright); }
		.post-description {
			font-family: var(--font-text);
			font-size: 17px;
			line-height: 1.55;
			color: var(--muted);
			display: -webkit-box;
			-webkit-line-clamp: 2;
			-webkit-box-orient: vertical;
			overflow: hidden;
		}
		@media (max-width: 720px) {
			.post-row { grid-template-columns: 1fr; gap: 18px; }
		}
	</style>
</BaseLayout>
