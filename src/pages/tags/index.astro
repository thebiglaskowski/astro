---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../../consts';
import { getAllTags } from '../../lib/blog';

const tags = await getAllTags();
---

<BaseLayout
	title={`Tags | ${SITE_TITLE}`}
	description="Browse blog posts by topic."
>
	<div class="page-shell">
		<section class="page-head">
			<div class="eyebrow">Index</div>
			<h1>Tags</h1>
			<p>Browse posts by topic.</p>
		</section>

		{tags.length === 0 ? (
			<p class="empty">No tags yet.</p>
		) : (
			<ul class="tag-cloud" role="list">
				{tags.map((tag) => (
					<li>
						<a href={`/tags/${tag.slug}/`} class="tag-pill">
							<span class="tag-name">{tag.name}</span>
							<span class="tag-count">{tag.count}</span>
						</a>
					</li>
				))}
			</ul>
		)}
	</div>

	<style>
		.tag-cloud {
			display: flex;
			flex-wrap: wrap;
			gap: 10px;
			padding: 0;
			margin: 0;
			list-style: none;
		}
		.tag-cloud :global(.tag-pill) { min-height: 44px; padding: 0 18px; font-size: 14px; }
		.empty { color: var(--muted); font-family: var(--font-text); }
	</style>
</BaseLayout>
