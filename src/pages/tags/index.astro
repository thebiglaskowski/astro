---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../../consts';
import { getAllTags } from '../../lib/blog';

const tags = await getAllTags();
---

<BaseLayout
	title={`Tags | ${SITE_TITLE}`}
	description="Browse blog posts by topic."
>
	<div class="tags-wrap">
		<section class="tags-header">
			<h1>Tags</h1>
			<p>Browse posts by topic.</p>
		</section>

		{tags.length === 0 ? (
			<p class="empty">No tags yet.</p>
		) : (
			<ul class="tag-cloud" role="list">
				{tags.map((tag) => (
					<li>
						<a href={`/tags/${tag.slug}/`} class="tag-pill">
							<span class="tag-name">{tag.name}</span>
							<span class="tag-count">{tag.count}</span>
						</a>
					</li>
				))}
			</ul>
		)}
	</div>

	<style>
		.tags-wrap {
			padding: 28px var(--gutter) 0;
			max-width: 800px;
			margin: 0 auto;
		}

		.tags-header {
			text-align: center;
			margin-bottom: 2rem;
			padding-bottom: 1.5rem;
			border-bottom: 1px double var(--rule);
		}

		.tags-header h1 {
			font-family: var(--font-serif);
			font-size: clamp(32px, 5vw, 52px);
			font-weight: 500;
			color: var(--paper-bright);
			letter-spacing: -0.02em;
			margin-bottom: 0.5rem;
		}

		.tags-header p {
			font-family: var(--font-serif);
			font-style: italic;
			font-size: 1rem;
			color: var(--mute);
		}

		.tag-cloud {
			display: flex;
			flex-wrap: wrap;
			gap: 0.75rem;
			padding: 0;
			margin: 2rem 0;
			list-style: none;
			justify-content: center;
		}

		.empty {
			text-align: center;
			color: var(--mute);
			margin: 2rem 0;
			font-family: var(--font-serif);
			font-style: italic;
		}
	</style>
</BaseLayout>
