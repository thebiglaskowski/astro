---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../../consts';
import { getAllTags } from '../../lib/blog';

const tags = await getAllTags();
---

<BaseLayout
	title={`Tags | ${SITE_TITLE}`}
	description="Browse blog posts by topic."
>
	<div class="container">
		<section class="tags-header">
			<h1 class="gradient-text">Tags</h1>
			<p>Browse posts by topic.</p>
		</section>

		{tags.length === 0 ? (
			<p class="empty">No tags yet.</p>
		) : (
			<ul class="tag-cloud" role="list">
				{tags.map((tag) => (
					<li>
						<a href={`/tags/${tag.slug}/`} class="tag-pill">
							<span class="tag-name">{tag.name}</span>
							<span class="tag-count">{tag.count}</span>
						</a>
					</li>
				))}
			</ul>
		)}
	</div>

	<style>
		.tags-header {
			text-align: center;
			margin: 3rem 0;
		}

		.tags-header h1 {
			font-size: 3rem;
			margin-bottom: 0.5rem;
			font-weight: 700;
		}

		.tags-header p {
			font-size: 1.125rem;
			color: var(--text-secondary);
		}

		.tag-cloud {
			display: flex;
			flex-wrap: wrap;
			gap: 0.75rem;
			padding: 0;
			margin: 2rem 0;
			list-style: none;
			justify-content: center;
		}

		.empty {
			text-align: center;
			color: var(--text-muted);
			margin: 2rem 0;
		}

		@media (max-width: 768px) {
			.tags-header h1 {
				font-size: 2.25rem;
			}
		}
	</style>
</BaseLayout>
