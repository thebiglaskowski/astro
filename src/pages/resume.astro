  <script>
    function initResume() {
      const btn = document.querySelector<HTMLButtonElement>('[data-expand]');
      const items = Array.from(
        document.querySelectorAll<HTMLDetailsElement>('.project-more')
      );
      if (!btn || items.length === 0) return;
      if (btn.dataset.wired === '1') return;
      btn.dataset.wired = '1';

      const sync = () => {
        const allOpen = items.every(d => d.open);
        btn.textContent = allOpen ? 'Collapse all' : 'Expand all';
      };

      btn.addEventListener('click', () => {
        const allOpen = items.every(d => d.open);
        items.forEach(d => { d.open = !allOpen; });
        sync();
      });

      items.forEach(d => d.addEventListener('toggle', sync));
      sync();

      // Printing a collapsed <details> hides its content, so open everything
      // for the print run and put it back afterwards.
      let restore: HTMLDetailsElement[] = [];
      window.addEventListener('beforeprint', () => {
        restore = items.filter(d => !d.open);
        restore.forEach(d => { d.open = true; });
      });
      window.addEventListener('afterprint', () => {
        restore.forEach(d => { d.open = false; });
        restore = [];
        sync();
      });
    }

    initResume();
    document.addEventListener('astro:page-load', initResume);
  </script>
</BaseLayout>
