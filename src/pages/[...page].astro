---
import type { GetStaticPathsOptions, Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { Image } from 'astro:assets';
import { getPublishedPosts, slugifyTag, readingTimeMinutes } from '../lib/blog';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
	const posts = await getPublishedPosts();
	return paginate(posts, { pageSize: 10 });
}

type Props = { page: Page<CollectionEntry<'blog'>> };
const { page } = Astro.props;
const isFirstPage = page.currentPage === 1;

const pageTitle = isFirstPage
	? `${SITE_TITLE} — AI art, dev tutorials, and creative technology`
	: `Page ${page.currentPage} | ${SITE_TITLE}`;

const websiteJsonLd = isFirstPage ? {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: SITE_TITLE,
	description: SITE_DESCRIPTION,
	url: new URL('/', Astro.site).toString(),
	author: { '@type': 'Person', name: 'Joe Laskowski', url: new URL('/about/', Astro.site).toString() },
} : null;

const fmt = (d: Date) =>
	d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

const romans = ['II','III','IV','V','VI','VII','VIII','IX','X','XI','XII'];

const [lead, ...rest] = page.data;

const postTag = (p: CollectionEntry<'blog'>) =>
	p.data.tag ?? p.data.tags?.[0] ?? 'Essay';
const postRead = (p: CollectionEntry<'blog'>) =>
	p.data.read ?? `${readingTimeMinutes(p.body)} min read`;
---

<BaseLayout title={pageTitle} description={SITE_DESCRIPTION}>
	{websiteJsonLd && (
		<script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
	)}

	{isFirstPage && lead ? (
		<div class="issue-body">
			<article>
				<div class="lead-kicker">
					<span class="manicule">☞</span>
					<span>The Feature</span>
					<span class="sep">§</span>
					<span class="italic">filed under {postTag(lead)}</span>
					<span class="sep">§</span>
					<span>{postRead(lead)}</span>
				</div>

				<h2 class="lead-title">
					<a href={`/blog/${lead.id}/`}>{lead.data.title}</a>
				</h2>

				{lead.data.heroImage && (
					<>
						<figure class="plate">
							<Image
								src={lead.data.heroImage}
								alt={lead.data.title}
								width={800}
								height={450}
								loading="eager"
								fetchpriority="high"
							/>
							<span class="corner-bl"></span>
							<span class="corner-br"></span>
						</figure>
						<div class="plate-cap">
							<span>Pl. I — {lead.data.title}</span>
							<span>{fmt(lead.data.pubDate)} · {postRead(lead)}</span>
						</div>
					</>
				)}

				{lead.data.excerpt ? (
					<div class="prose two-col with-drop-cap" set:html={lead.data.excerpt} />
				) : (
					<div class="prose two-col with-drop-cap">
						<p>{lead.data.description}</p>
					</div>
				)}

				{lead.data.pullquote && (
					<div class="pullquote">
						<span class="mark">⁂</span>
						{lead.data.pullquote}
					</div>
				)}

				<div class="byline">
					<span>By Joe Laskowski · Set in Newsreader &amp; IBM Plex Sans</span>
					<a class="cont" href={`/blog/${lead.id}/`}>Continue reading ❧</a>
				</div>
			</article>

			<div class="col-divider"></div>

			<aside>
				<h3 class="rail-head"><span class="fleur">❦</span> Table of Contents</h3>
				<div class="rail-sub">In this issue — {page.data.length} dispatch{page.data.length !== 1 ? 'es' : ''}</div>

				{rest.map((p, i) => (
					<a class="toc-row" href={`/blog/${p.id}/`}>
						<div class="toc-num">{romans[i] ?? String(i + 2)}</div>
						<div>
							<h4 class="toc-title">{p.data.title}</h4>
							<div class="toc-meta">{fmt(p.data.pubDate)} · {postTag(p)} · {postRead(p)}</div>
						</div>
						<div class="toc-page">p.{String(8 + i * 4).padStart(2, '0')}</div>
					</a>
				))}

				{page.data.length > 0 && (
					<div class="marginalia">
						<span class="corner-bl"></span>
						<span class="corner-br"></span>
						<div class="marginalia-eyebrow">❦ Marginalia</div>
						<div class="marginalia-body">
							<em>Currently reading</em> — The 48 Laws of Power, Robert Greene.<br/>
							<em>Drinking</em> — Eagle Rare 10 year, neat.<br/>
							<em>Running</em> — Out of patience.
						</div>
					</div>
				)}
			</aside>
		</div>
	) : (
		<div class="archive-page">
			<div class="archive-head">
				<h2>Archive — Page {page.currentPage}</h2>
				<div class="archive-sub">{page.total} dispatches in the archive</div>
			</div>

			{page.data.map((post, i) => (
				<a class="toc-row" href={`/blog/${post.id}/`}>
					<div class="toc-num">{String((page.currentPage - 1) * 10 + i + 1)}</div>
					<div>
						<h4 class="toc-title">{post.data.title}</h4>
						<div class="toc-meta">{fmt(post.data.pubDate)} · {postTag(post)} · {postRead(post)}</div>
					</div>
					<div class="toc-page">{fmt(post.data.pubDate)}</div>
				</a>
			))}
		</div>
	)}

	{page.lastPage > 1 && (
		<nav class="pagination" aria-label="Pagination">
			{page.url.prev ? (
				<a href={page.url.prev} rel="prev">← Newer</a>
			) : (
				<span class="disabled">← Newer</span>
			)}
			<span class="page-info">Page {page.currentPage} of {page.lastPage}</span>
			{page.url.next ? (
				<a href={page.url.next} rel="next">Older →</a>
			) : (
				<span class="disabled">Older →</span>
			)}
		</nav>
	)}
</BaseLayout>

<style>
	.archive-page {
		padding: 28px var(--gutter) 0;
		max-width: 800px;
		margin: 0 auto;
	}

	.archive-head {
		margin-bottom: 24px;
		padding-bottom: 14px;
		border-bottom: 1px double var(--rule);
	}

	.archive-head h2 {
		font-family: var(--font-serif);
		font-size: 28px;
		color: var(--paper-bright);
	}

	.archive-sub {
		font-size: 10.5px;
		letter-spacing: .28em;
		text-transform: uppercase;
		color: var(--mute);
		margin-top: 6px;
	}

	.pagination {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		padding: 20px var(--gutter);
		margin-top: 28px;
		border-top: 1px solid var(--rule);
		font-size: 11px;
		letter-spacing: .22em;
		text-transform: uppercase;
		color: var(--mute);
	}

	.pagination a {
		color: var(--steel);
		transition: color .15s;
	}

	.pagination a:hover {
		color: var(--paper-bright);
	}

	.pagination .disabled {
		opacity: 0.35;
	}
</style>
