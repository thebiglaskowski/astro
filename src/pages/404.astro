---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../consts';
---

<BaseLayout title={`Page Not Found | ${SITE_TITLE}`} description="The page you're looking for doesn't exist.">
	<section class="page-shell not-found">
		<div class="eyebrow">Error 404</div>
		<h1><span class="prompt">$</span> cd ./this-page</h1>
		<p class="err">No such file or directory — the page you're looking for doesn't exist.</p>
		<a href="/" class="btn">Back to the journal</a>
	</section>

	<style>
		.not-found {
			min-height: 60vh;
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			justify-content: center;
			gap: 24px;
		}
		.not-found h1 { font-size: clamp(28px, 5vw, 56px); line-height: 1.1; word-break: break-all; }
		.prompt { color: var(--accent); }
		.err { margin: 0; font-family: var(--font-text); font-size: 20px; color: var(--muted); }
	</style>
</BaseLayout>
