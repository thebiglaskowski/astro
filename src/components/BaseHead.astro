---
import '../styles/global.css';
import { SITE_TITLE } from '../consts';
import monoUrl from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import serifUrl from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';

interface Props {
	title: string;
	description: string;
	image?: string;
	preloadImage?: string;
	preloadImageSrcset?: string;
	preloadImageSizes?: string;
	/** Keep the page out of search results but let crawlers follow its links */
	noindex?: boolean;
	/** Marks the page as an article for Open Graph / search engines */
	article?: { published: Date; modified?: Date; tags?: string[] };
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description: fullDescription, image, preloadImage, preloadImageSrcset, preloadImageSizes, noindex = false, article } = Astro.props;

// Search results cut descriptions off around 155-160 characters; end on a
// word instead of mid-word. The page itself still shows the full text.
const snippet = (text: string, max = 155) => {
	if (text.length <= max) return text;
	const cut = text.slice(0, max + 1);
	const space = cut.lastIndexOf(' ');
	const trimmed = cut.slice(0, space > 80 ? space : max).replace(/[\s,;:—–-]+$/, '');
	return /[.!?]$/.test(trimmed) ? trimmed : `${trimmed}…`;
};
const description = snippet(fullDescription);

const gaId = import.meta.env.PUBLIC_GA_ID;
const analyticsEnabled = import.meta.env.PROD && Boolean(gaId);

const TWITTER_HANDLE = '@thebiglaskowski';
---

{analyticsEnabled && (
	<>
		<!-- Google Analytics (via Partytown); skipped when navigator.doNotTrack is enabled -->
		<script is:inline define:vars={{ gaId }}>
			(function () {
				var dnt = navigator.doNotTrack || window.doNotTrack || navigator.msDoNotTrack;
				if (dnt === '1' || dnt === 'yes') return;
				var s1 = document.createElement('script');
				s1.type = 'text/partytown';
				s1.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
				document.head.appendChild(s1);
				var s2 = document.createElement('script');
				s2.type = 'text/partytown';
				s2.text =
					'window.dataLayer = window.dataLayer || [];' +
					'function gtag(){dataLayer.push(arguments);}' +
					'gtag("js", new Date());' +
					'gtag("config", "' + gaId + '");';
				document.head.appendChild(s2);
			})();
		</script>
	</>
)}

<!-- Preload critical fonts -->
<link rel="preload" as="font" type="font/woff2" href={monoUrl} crossorigin />
<link rel="preload" as="font" type="font/woff2" href={serifUrl} crossorigin />

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#0d0f13" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Preload critical assets -->
{preloadImageSrcset ? (
	<link rel="preload" as="image" imagesrcset={preloadImageSrcset} imagesizes={preloadImageSizes} fetchpriority="high" />
) : preloadImage && (
	<link rel="preload" href={preloadImage} as="image" fetchpriority="high" />
)}

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, follow" />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={article ? 'article' : 'website'} />
{article && <meta property="article:published_time" content={article.published.toISOString()} />}
{article?.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
{article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="en_US" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{image && <meta property="og:image" content={new URL(image, Astro.url)} />}
{image && <meta property="og:image:alt" content={title} />}

<!-- Twitter -->
<meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
<meta name="twitter:site" content={TWITTER_HANDLE} />
<meta name="twitter:creator" content={TWITTER_HANDLE} />
<meta name="twitter:url" content={Astro.url} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{image && <meta name="twitter:image" content={new URL(image, Astro.url)} />}
{image && <meta name="twitter:image:alt" content={title} />}
