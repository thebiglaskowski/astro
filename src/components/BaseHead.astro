---
import '../styles/global.css';
import { SITE_TITLE } from '../consts';
import newsreaderNormalUrl from '@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url';
import newsreaderItalicUrl from '@fontsource-variable/newsreader/files/newsreader-latin-opsz-italic.woff2?url';
import ibmPlexUrl from '@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url';

interface Props {
	title: string;
	description: string;
	image?: string;
	preloadImage?: string;
	preloadImageSrcset?: string;
	preloadImageSizes?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image, preloadImage, preloadImageSrcset, preloadImageSizes } = Astro.props;

const gaId = import.meta.env.PUBLIC_GA_ID;
const analyticsEnabled = import.meta.env.PROD && Boolean(gaId);

const TWITTER_HANDLE = '@thebiglaskowski';
---

{analyticsEnabled && (
	<>
		<!-- Google Analytics (via Partytown); skipped when navigator.doNotTrack is enabled -->
		<script is:inline define:vars={{ gaId }}>
			(function () {
				var dnt = navigator.doNotTrack || window.doNotTrack || navigator.msDoNotTrack;
				if (dnt === '1' || dnt === 'yes') return;
				var s1 = document.createElement('script');
				s1.type = 'text/partytown';
				s1.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
				document.head.appendChild(s1);
				var s2 = document.createElement('script');
				s2.type = 'text/partytown';
				s2.text =
					'window.dataLayer = window.dataLayer || [];' +
					'function gtag(){dataLayer.push(arguments);}' +
					'gtag("js", new Date());' +
					'gtag("config", "' + gaId + '");';
				document.head.appendChild(s2);
			})();
		</script>
	</>
)}

<!-- Preload critical fonts -->
<link rel="preload" as="font" type="font/woff2" href={newsreaderNormalUrl} crossorigin />
<link rel="preload" as="font" type="font/woff2" href={newsreaderItalicUrl} crossorigin />
<link rel="preload" as="font" type="font/woff2" href={ibmPlexUrl} crossorigin />

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#07070a" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Preload critical assets -->
{preloadImageSrcset ? (
	<link rel="preload" as="image" imagesrcset={preloadImageSrcset} imagesizes={preloadImageSizes} fetchpriority="high" />
) : preloadImage && (
	<link rel="preload" href={preloadImage} as="image" fetchpriority="high" />
)}

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="en_US" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{image && <meta property="og:image" content={new URL(image, Astro.url)} />}
{image && <meta property="og:image:alt" content={title} />}

<!-- Twitter -->
<meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
<meta name="twitter:site" content={TWITTER_HANDLE} />
<meta name="twitter:creator" content={TWITTER_HANDLE} />
<meta name="twitter:url" content={Astro.url} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{image && <meta name="twitter:image" content={new URL(image, Astro.url)} />}
{image && <meta name="twitter:image:alt" content={title} />}
