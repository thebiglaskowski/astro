---
import { SITE_TITLE } from '../consts';
const today = new Date();
---

<footer>
  <div class="container">
    <div class="footer-content">
      <p>&copy; 2021-{today.getFullYear()} {SITE_TITLE}. All rights reserved.</p>
      <div class="footer-links">
        <a href="/about/">About</a>
        <a href="/">Blog</a>
        <a href="/contact/">Contact</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer {
    background-color: transparent;
    border-top: 1px solid var(--rule);
    margin-top: 4rem;
    padding: 2rem 0;
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
  }

  footer p {
    margin: 0;
    color: var(--mute);
    font-size: 0.9rem;
  }

  .footer-links {
    display: flex;
    gap: 1.5rem;
  }

  .footer-links a {
    color: var(--mute);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s ease;
  }

  .footer-links a:hover {
    color: var(--steel);
  }

  @media (max-width: 768px) {
    .footer-content {
      flex-direction: column;
      text-align: center;
      gap: 1rem;
    }

    .footer-links {
      justify-content: center;
    }
  }
</style>
