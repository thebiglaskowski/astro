---
import HeaderLink from './HeaderLink.astro';
import SocialIcon from './SocialIcon.astro';
import { SITE_TITLE } from '../consts';
---

<header transition:persist>
  <a href="#main-content" class="skip-link">Skip to content</a>
  <div class="container">
    <nav>
      <h2><a href="/">{SITE_TITLE}</a></h2>
      <div class="internal-links">
        <HeaderLink href="/">Blog</HeaderLink>
        <HeaderLink href="/about/">About</HeaderLink>
        <HeaderLink href="/contact/">Contact</HeaderLink>
      </div>

      <div class="nav-actions">
        <button type="button" class="search-toggle" aria-label="Search" aria-expanded="false" aria-controls="search-panel">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>

        <div class="social-links">
        <a href="https://github.com/thebiglaskowski" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
          <SocialIcon icon="github" />
        </a>
        <a href="https://x.com/thebiglaskowski" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)">
          <SocialIcon icon="x" />
        </a>
        <a href="https://www.linkedin.com/in/thebiglaskowski" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
          <SocialIcon icon="linkedin" />
        </a>
        <a href="https://www.youtube.com/@JoeLaskowski" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
          <SocialIcon icon="youtube" />
        </a>
        </div>
      </div>
    </nav>
  </div>

  <div id="search-panel" class="search-panel" hidden>
    <div class="container">
      <div id="search"></div>
    </div>
  </div>
</header>

<script>
  type SearchUIOptions = Record<string, unknown>;
  interface PagefindUIWindow extends Window {
    PagefindUI?: new (options: SearchUIOptions) => unknown;
  }
  const w = window as PagefindUIWindow;

  let pagefindLoaded = false;

  function loadPagefind(): Promise<void> {
    if (pagefindLoaded) return Promise.resolve();
    pagefindLoaded = true;

    return new Promise((resolve, reject) => {
      const css = document.createElement('link');
      css.rel = 'stylesheet';
      css.href = '/pagefind/pagefind-ui.css';
      document.head.appendChild(css);

      const js = document.createElement('script');
      js.src = '/pagefind/pagefind-ui.js';
      js.onload = () => {
        if (!w.PagefindUI) { reject(new Error('PagefindUI failed to load')); return; }
        new w.PagefindUI({ element: '#search', showSubResults: true, resetStyles: false });
        resolve();
      };
      js.onerror = () => reject(new Error('PagefindUI script error'));
      document.body.appendChild(js);
    });
  }

  function initHeader() {
    const toggle = document.querySelector<HTMLButtonElement>('.search-toggle');
    const panel = document.querySelector<HTMLElement>('#search-panel');
    if (!toggle || !panel) return;
    if (toggle.dataset.wired === '1') return;
    toggle.dataset.wired = '1';

    toggle.addEventListener('click', async () => {
      const isOpen = !panel.hasAttribute('hidden');
      if (isOpen) {
        panel.setAttribute('hidden', '');
        toggle.setAttribute('aria-expanded', 'false');
      } else {
        panel.removeAttribute('hidden');
        toggle.setAttribute('aria-expanded', 'true');
        try {
          await loadPagefind();
          const input = panel.querySelector<HTMLInputElement>('input');
          input?.focus();
        } catch (err) {
          console.error(err);
        }
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hasAttribute('hidden')) {
        panel.setAttribute('hidden', '');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.focus();
      }
    });

    // Close the panel when a result is clicked (the header persists across
    // view transitions, so without this the panel would stay open after navigation)
    document.addEventListener('astro:before-preparation', () => {
      if (!panel.hasAttribute('hidden')) {
        panel.setAttribute('hidden', '');
        toggle.setAttribute('aria-expanded', 'false');
      }
    });
  }

  initHeader();

  function updateActiveLinks() {
    const pathname = window.location.pathname;
    const firstSegment = pathname.replace(/^\//, '').split('/')[0] || '';
    document.querySelectorAll<HTMLAnchorElement>('header nav .internal-links a').forEach(link => {
      const href = link.getAttribute('href') ?? '';
      const isHome = href === '/';
      const isActive =
        href === pathname ||
        href === '/' + firstSegment ||
        (isHome && (pathname === '/' || firstSegment === 'blog'));
      link.classList.toggle('active', isActive);
    });
  }

  document.addEventListener('astro:page-load', updateActiveLinks);
</script>

<style is:global>
  /* Pagefind UI noir-theme overrides */
  #search {
    --pagefind-ui-primary: var(--oxblood);
    --pagefind-ui-text: var(--paper);
    --pagefind-ui-background: #0d0c0e;
    --pagefind-ui-border: var(--rule);
    --pagefind-ui-tag: var(--rule-dim);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 2px;
    --pagefind-ui-font: var(--font-sans);
  }

  #search .pagefind-ui__search-input {
    background: var(--ink);
    color: var(--paper);
  }

  #search .pagefind-ui__result-title a {
    color: var(--oxblood);
  }
</style>

<style>
  header {
    background: rgba(7, 7, 10, 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--rule);
    padding: 1rem 0;
    position: sticky;
    top: 0;
    z-index: 50;
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  h2 {
    margin: 0;
    font-size: 1.5rem;
  }

  h2 a {
    color: var(--oxblood);
    text-decoration: none;
    transition: color 0.15s;
  }

  h2 a:hover {
    color: var(--steel);
  }

  .internal-links {
    display: flex;
    gap: 2rem;
  }

  .search-toggle {
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: 2px;
    color: var(--mute);
    padding: 0.4rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
  }

  .search-toggle:hover {
    color: var(--steel);
    border-color: var(--steel);
  }

  .search-panel {
    background: rgba(7, 7, 10, 0.96);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-top: 1px solid var(--rule);
    padding: 1.5rem 0;
  }

  .search-panel[hidden] {
    display: none;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .social-links {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .social-links a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    color: var(--mute);
    transition: color 0.15s;
    text-decoration: none;
  }

  .social-links a:hover {
    color: var(--steel);
  }

  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    background: var(--oxblood);
    color: var(--ink);
    padding: 0.5rem 1rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 0 0 4px 4px;
  }

  .skip-link:focus {
    left: 50%;
    transform: translateX(-50%);
  }

  @media (max-width: 768px) {
    nav {
      flex-direction: column;
      gap: 1rem;
    }

    .internal-links {
      gap: 1rem;
    }
  }
</style>
